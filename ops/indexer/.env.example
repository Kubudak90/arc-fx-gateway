# arcora-indexer — runtime env. Copy to /root/arcora-ops/indexer/.env on the
# VPS, chmod 600. Sourced by both the systemd unit (EnvironmentFile=) and
# replay.ts when run from this directory.

# ── chain ───────────────────────────────────────────────────────────

ARC_TESTNET_RPC=https://rpc.testnet.arc.network

# V10 custody-escrow gateway (canonical, Plan 10 since 2026-05-07).
# Indexer watches a single gateway in V10; legacy V6/V8/V9 cohorts were
# retired during the V10 hard cutover (DB wiped, contract sources moved
# to packages/contracts/legacy/).
GATEWAY_ADDRESS_V10=0x...

# ── database ────────────────────────────────────────────────────────

# Postgres (Neon) — same DSN the app, relayer, and webhook daemons share.
POSTGRES_URL_NON_POOLING=postgresql://...

# ── tunables ────────────────────────────────────────────────────────

INDEXER_REORG_BUFFER_BLOCKS=5     # optional, default 5
INDEXER_TICK_MS=30000             # optional, default 30s
