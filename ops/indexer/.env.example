# arcora-indexer — runtime env. Copy to /root/arcora-ops/indexer/.env on the
# VPS, chmod 600. Sourced by both the systemd unit (EnvironmentFile=) and
# replay.ts when run from this directory.

# ── chain ───────────────────────────────────────────────────────────

ARC_TESTNET_RPC=https://rpc.testnet.arc.network

# Previous deploy (V10). Required during the soft cutover so the indexer
# dual-watches both contracts via `address: [V10, V11]` and keeps tagging
# escrow events from V10 (which remain claimable through V10's 7-day
# refund + 7-day recovery window). Drop this var once no V10 escrows are
# still pending.
GATEWAY_ADDRESS_V10=0xc91e45ffe945c0e6e2c0f8262a35477e20a5f154

# Active custody-escrow gateway (V11, 2026-05-13). Required.
# Canonical addresses live in packages/contracts/deployments/arc-testnet.json.
GATEWAY_ADDRESS_V11=0x07BAC123A682D24d3eC439ce454cA8AC64eAe3A3

# Legacy V6/V8/V9 cohorts were retired during the V10 hard cutover (DB
# wiped, contract sources moved to packages/contracts/legacy/). Re-enabling
# them would require a separate indexer pass; not supported here.

# ── database ────────────────────────────────────────────────────────

# Postgres (Neon) — same DSN the app, relayer, and webhook daemons share.
POSTGRES_URL_NON_POOLING=postgresql://...

# ── tunables ────────────────────────────────────────────────────────

INDEXER_REORG_BUFFER_BLOCKS=5     # optional, default 5
INDEXER_TICK_MS=30000             # optional, default 30s
