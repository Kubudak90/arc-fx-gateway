# arcora-indexer — runtime env. Copy to /root/arcora-ops/indexer/.env on the
# VPS, chmod 600. Sourced by both the systemd unit (EnvironmentFile=) and
# replay.ts when run from this directory.

# ── chain ───────────────────────────────────────────────────────────

ARC_TESTNET_RPC=https://rpc.testnet.arc.network

# Canonical (current) gateway. Set this to the address the application is
# emitting new InvoiceCreated events for — V9 today.
GATEWAY_ADDRESS=0x...

# Optional: legacy V6 cohort. Drop once the v0.6 in-flight cohort drains.
# When unset the indexer simply ignores V6 events. Audit M6 (2026-05-05).
GATEWAY_ADDRESS_V6=

# Optional: V8 cohort. Drop once the v0.8 in-flight cohort drains.
GATEWAY_ADDRESS_V8=

# Optional: V9 cohort, watched in parallel during a rolling cutover.
GATEWAY_ADDRESS_V9=

# ── database ────────────────────────────────────────────────────────

# Postgres (Neon) — same DSN the app, relayer, and webhook daemons share.
POSTGRES_URL_NON_POOLING=postgresql://...

# ── tunables ────────────────────────────────────────────────────────

INDEXER_REORG_BUFFER_BLOCKS=5     # optional, default 5
INDEXER_TICK_MS=30000             # optional, default 30s
