pragma solidity ^0.8.26;

import { Script, console2 } from "forge-std/Script.sol";
import { ArcFXGateway } from "../src/ArcFXGateway.sol";
import { IStablePool } from "../src/pool/IStablePool.sol";
import { IStablecoinRegistry } from "../src/registry/IStablecoinRegistry.sol";

/// @notice Deploys the v0.7 (pool-routing) ArcFXGateway. Pool and registry
/// must already be deployed. Kept for backward compatibility while v0.8
/// (pool-free, relayer-driven) rolls out — see DeployV8.s.sol.
///
/// Required env vars:
///   DEPLOYER_PRIVATE_KEY    — uint256 hex
///   STABLE_POOL_ADDRESS     — address of deployed StablePool
///   STABLECOIN_REGISTRY     — address of deployed StablecoinRegistry
///   TREASURY_OWNER          — address that will own the gateway and receive withdrawn fees
///   PROTOCOL_FEE_BPS        — uint256 (e.g. 10 for 0.10%)
contract Deploy is Script {
    function run() external returns (ArcFXGateway gw) {
        uint256 pk           = vm.envUint("DEPLOYER_PRIVATE_KEY");
        address poolAddr     = vm.envAddress("STABLE_POOL_ADDRESS");
        address registryAddr = vm.envAddress("STABLECOIN_REGISTRY");
        address owner        = vm.envAddress("TREASURY_OWNER");
        uint256 feeBps       = vm.envUint("PROTOCOL_FEE_BPS");

        vm.startBroadcast(pk);
        gw = new ArcFXGateway(
            IStablePool(poolAddr),
            IStablecoinRegistry(registryAddr),
            feeBps,
            owner
        );
        vm.stopBroadcast();

        console2.log("ArcFXGateway deployed:", address(gw));
        console2.log("Pool:               ", poolAddr);
        console2.log("Registry:           ", registryAddr);
        console2.log("Owner:              ", owner);
        console2.log("Protocol fee (bps): ", feeBps);
    }
}
