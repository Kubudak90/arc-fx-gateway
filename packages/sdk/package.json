{
  "name": "@arcora/sdk",
  "version": "1.1.0",
  "description": "Stripe-style checkout SDK for Arcora — stablecoin payments on Arc Network",
  "keywords": ["arcora", "stablecoin", "checkout", "payments", "arc", "usdc", "eurc"],
  "unpkg": "./dist/arcora.global.js",
  "jsdelivr": "./dist/arcora.global.js",
  "homepage": "https://github.com/Kubudak90/arc-fx-gateway/tree/plan-1-protocol/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kubudak90/arc-fx-gateway.git",
    "directory": "packages/sdk"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./global": "./dist/arcora.global.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
